# ---- Backend (never put these in Flutter) ----
APP_ENV=development            # development | production
DEMO_MODE=true                 # true = mock AI/STT providers, clearly labeled results
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=     # server only. NEVER ship to the app.
SUPABASE_JWT_SECRET=           # Project Settings > API > JWT Secret
STORAGE_BUCKET_LECTURES=lectures
STORAGE_BUCKET_DOCUMENTS=documents
STORAGE_BUCKET_CASES=case-attachments

# LLM provider (any OpenAI-compatible endpoint)
LLM_PROVIDER=mock              # mock | openai_compat
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Speech-to-text provider
STT_PROVIDER=mock              # mock | openai_compat
STT_BASE_URL=https://api.openai.com/v1
STT_API_KEY=
STT_MODEL=whisper-1

# Limits
MAX_UPLOAD_MB=1024
MAX_LECTURE_MINUTES=240
SEGMENT_SECONDS=600
SEGMENT_OVERLAP_SECONDS=5
RATE_LIMIT_PER_MINUTE=60

# Optional Redis queue (otherwise in-process worker is used in dev)
REDIS_URL=
# Case images are NEVER sent to AI providers unless explicitly enabled by the institution
ALLOW_CASE_IMAGE_AI=false
